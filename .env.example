# Copy to .env for docker compose:  cp .env.example .env
POSTGRES_USER=beautyskin
POSTGRES_PASSWORD=beautyskin
POSTGRES_DB=beautyskin
POSTGRES_PORT=5434

# Spring Boot (optional overrides; defaults match docker-compose above)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/beautyskin
SPRING_DATASOURCE_USERNAME=beautyskin
SPRING_DATASOURCE_PASSWORD=beautyskin

# JWT signing secret (min 32 characters for HS256)
JWT_SECRET=beautyskin-dev-secret-change-in-production-min-32-chars
