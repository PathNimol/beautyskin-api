# Copy to .env for docker compose:  cp .env.example .env
POSTGRES_USER=beautyskin
POSTGRES_PASSWORD=beautyskin
POSTGRES_DB=beautyskin
POSTGRES_PORT=5434

# Spring Boot (optional overrides; defaults match docker-compose above)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/beautyskin
SPRING_DATASOURCE_USERNAME=beautyskin
SPRING_DATASOURCE_PASSWORD=beautyskin

# JWT signing secret (min 32 characters for HS256)
JWT_SECRET=beautyskin-dev-secret-change-in-production-min-32-chars

# SPRING_PROFILES_ACTIVE=prod

# Registration: when true, OTP email must be delivered or signup rolls back (recommended with prod profile).
# APP_AUTH_REGISTRATION_REQUIRE_DELIVERED_EMAIL=false

# Demo JWT OAuth stub (disable in production / use browser OAuth2 instead).
# APP_OAUTH_DEMO_STUB_ENABLED=false

# OTP / verification emails (optional).
# Example (Gmail): use an App Password, not your normal password, if 2FA is enabled.
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=you@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password
# APP_MAIL_FROM=you@gmail.com
